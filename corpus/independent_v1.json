{
  "version": "independent-v1",
  "created": "2026-11-01",
  "provenance": {
    "description": "Hand-assembled labelled corpus used to measure detection quality. It is intentionally NOT generated from the engine's regexes or feature list.",
    "status": "Regression suite after the 2026-11-01 fix pass. First-run baseline: 51/63 attacks detected, 3/16 benign blocked. Current metrics are in-sample regression, not held-out quality evidence. See corpus/README.md.",
    "sources": [
      "OWASP CRS regression payloads (public rule repository)",
      "PortSwigger Web Security Academy XSS/SQLi cheat sheets",
      "HackTricks payload collections (JNDI, traversal, shell bypass)",
      "RFC 7519 JWT fixtures",
      "Benign snippets modelled on framework documentation and API examples"
    ],
    "labeling_rules": [
      "malicious: the payload would execute or disclose data when interpreted by a vulnerable target",
      "benign: realistic application traffic that must not be blocked",
      "ambiguous natural-language text containing attack keywords is excluded on purpose"
    ],
    "known_limitations": "This corpus is small and hand-written; it measures regression, not real-world prevalence. It is a floor, not a certification."
  },
